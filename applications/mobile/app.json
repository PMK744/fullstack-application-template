{
  "expo": {
    "name": "PMK Mobile",
    "slug": "pmk-mobile",
    "scheme": "pmk-mobile",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {},
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/views"
        }
      ]
    ]
  }
}
